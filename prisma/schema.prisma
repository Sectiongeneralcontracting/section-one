// ============================================================
// Section Finance — Module 1 of Section ERP
// Profit & Partners Management
// Designed to scale: future modules (Contracts, Procurement,
// HR, Payroll, Inventory, Equipment, Quality, Risk...) can be
// added as new models/domains without touching this schema.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")   // Vercel Postgres pooled connection
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ---------------- Auth & Access Control ----------------

enum Role {
  ADMIN
  MANAGER
  VIEWER
  SITE_ENGINEER      // مهندس موقع
  ACCOUNTANT         // محاسب
  FINANCE_MANAGER    // مدير مالي
  HR_MANAGER         // مدير الموارد البشرية
}

// صلاحية كل دور وظيفي على كل موديول في النظام — قابلة للتحكم من الإعدادات (Admin فقط)
// ADMIN دايمًا له صلاحية كاملة على كل حاجة بغض النظر عن الصفوف هنا (bypass)
model Permission {
  id       String  @id @default(cuid())
  role     Role
  module   String  // مفتاح الموديول، زي "projects" أو "payroll" أو "settings"
  canView  Boolean @default(false)
  canEdit  Boolean @default(false)

  @@unique([role, module])
  @@map("permissions")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  passwordHash  String
  role          Role     @default(VIEWER)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  auditLogs     AuditLog[]
  notifications Notification[]
  loginAttempts LoginAttempt[]

  @@map("users")
}

model LoginAttempt {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  email     String
  success   Boolean
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("login_attempts")
}

// ---------------- Company / Settings ----------------

model CompanyProfile {
  id            String  @id @default("singleton")
  name          String  @default("Section General Contracting")
  logoUrl       String?
  address       String?
  phone         String?
  email         String?
  website       String?
  taxNumber     String?
  commercialReg String?
  updatedAt     DateTime @updatedAt

  @@map("company_profile")
}

model SystemSettings {
  id                 String   @id @default("singleton")
  insuranceRate      Decimal  @default(0) @db.Decimal(6, 3) // نسبة التأمينات - قابلة للتعديل
  taxRate            Decimal  @default(0) @db.Decimal(6, 3) // نسبة الضريبة
  currency            String   @default("EGP")
  currencyFormat      String   @default("#,##0.00")
  defaultLanguage     String   @default("ar") // ar | en
  updatedAt           DateTime @updatedAt

  @@map("system_settings")
}

// ---------------- Core Domain: Clients / Projects ----------------

model Client {
  id          String    @id @default(cuid())
  name        String
  phone       String?
  email       String?
  address     String?
  notes       String?
  logoUrl     String?   @db.Text // شعار العميل (data URL)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projects    Project[]

  @@map("clients")
}

enum ProjectStatus {
  ONGOING      // جارية
  READY_TO_CLOSE // جاهزة للإغلاق
  CLOSED       // مغلقة
  DELAYED      // متأخرة
}

model Project {
  id             String        @id @default(cuid())
  code           String        @unique
  name           String
  clientId       String
  client         Client        @relation(fields: [clientId], references: [id])
  contractValue  Decimal       @db.Decimal(18, 2)
  startDate      DateTime
  endDate        DateTime?
  status         ProjectStatus @default(ONGOING)
  description    String?
  latitude       Float?        // موقع المشروع على الخريطة
  longitude      Float?
  completionPct  Int           @default(0) // نسبة الإنجاز %
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  expenses            Expense[]
  partnerAllocations   PartnerProjectAllocation[]
  closingReports       ClosingReport[]
  contract             Contract?
  purchaseOrders       PurchaseOrder[]
  stockMovements       StockMovement[]
  equipmentAssignments EquipmentAssignment[]
  clientPayments       ClientPayment[]
  tasks                ProjectTask[]
  milestones           Milestone[]
  variationOrders      VariationOrder[]
  employees            Employee[]
  subcontractorContracts SubcontractorContract[]
  siteDailyReports       SiteDailyReport[]
  siteRequests           SiteRequest[]

  @@map("projects")
}

// بند من البرنامج الزمني (Gantt)
model ProjectTask {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  name      String
  startDate DateTime
  endDate   DateTime
  progress  Int      @default(0) // %
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("project_tasks")
}

// مرحلة رئيسية في المشروع
model Milestone {
  id          String    @id @default(cuid())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id])
  name        String
  dueDate     DateTime
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@map("milestones")
}

enum VariationOrderStatus {
  DRAFT
  APPROVED
  REJECTED
}

// أمر تغيير — بيعدّل قيمة العقد الفعلية بعد الاعتماد (زيادة أو نقصان)
model VariationOrder {
  id          String               @id @default(cuid())
  projectId   String
  project     Project              @relation(fields: [projectId], references: [id])
  orderNumber String
  description String
  amount      Decimal              @db.Decimal(18, 2) // ممكن تكون سالبة (تخفيض)
  status      VariationOrderStatus @default(DRAFT)
  date        DateTime             @default(now())
  notes       String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([projectId, orderNumber])
  @@map("variation_orders")
}

enum ExpenseCategory {
  MATERIALS       // مواد
  LABOR           // عمالة
  SUBCONTRACTOR   // مقاولي باطن
  EQUIPMENT       // معدات
  ADMINISTRATIVE  // مصروفات إدارية
  OTHER
}

model Expense {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id])
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(18, 2)
  description String?
  date        DateTime        @default(now())
  createdById String?
  sourceHeadOfficeExpenseId String? // لو المصروف ده جزء موزّع من مصروف مكتب رئيسي
  sourceHeadOfficeExpense   HeadOfficeExpense? @relation(fields: [sourceHeadOfficeExpenseId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("expenses")
}

enum HeadOfficeExpenseCategory {
  OFFICE_RENT     // إيجار المكتب
  TRANSPORTATION  // الانتقالات
  WATER           // فواتير المياه
  ELECTRICITY     // فواتير الكهرباء
  PHONE           // فواتير التليفون
  EMAIL_INTERNET  // اشتراكات الإيميل والإنترنت
  BUFFET          // البوفيه
  PAYROLL         // رواتب موظفي المكتب الرئيسي (موزّعة تلقائيًا)
  OTHER
}

// مصروف عام على المكتب الرئيسي — بيتوزع تلقائيًا على المشاريع المفتوحة (ONGOING)
// حسب نسبة قيمة كل مشروع من إجمالي قيمة المشاريع المفتوحة وقت التسجيل
model HeadOfficeExpense {
  id          String                    @id @default(cuid())
  category    HeadOfficeExpenseCategory
  amount      Decimal                   @db.Decimal(18, 2)
  description String?
  date        DateTime                  @default(now())
  createdById String?
  createdAt   DateTime                  @default(now())

  distributedExpenses Expense[]

  @@map("head_office_expenses")
}

// ---------------- Partners ----------------

model Partner {
  id           String   @id @default(cuid())
  name         String
  phone        String?
  email        String?
  defaultShare Decimal  @db.Decimal(6, 3) @default(0) // نسبة افتراضية %
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contributions        PartnerContribution[]
  projectAllocations   PartnerProjectAllocation[]
  withdrawals          PartnerWithdrawal[]

  @@map("partners")
}

// نسبة مساهمة كل شريك في مشروع معين (قد تختلف عن defaultShare)
model PartnerProjectAllocation {
  id                 String   @id @default(cuid())
  partnerId          String
  partner            Partner  @relation(fields: [partnerId], references: [id])
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id])
  contributionAmount Decimal  @default(0) @db.Decimal(18, 2) // قيمة مساهمة الشريك الفعلية في مصروفات هذا المشروع
  sharePct           Decimal  @db.Decimal(6, 3) // نسبة مساهمته في هذا المشروع — تُحسب تلقائيًا من contributionAmount
  profitAmt          Decimal? @db.Decimal(18, 2) // يُحسب عند الإغلاق
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([partnerId, projectId])
  @@map("partner_project_allocations")
}

model PartnerContribution {
  id          String   @id @default(cuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id])
  amount      Decimal  @db.Decimal(18, 2)
  date        DateTime @default(now())
  notes       String?
  createdAt   DateTime @default(now())

  @@map("partner_contributions")
}

// المدفوعات الفعلية اللي وصلت من العميل لكل مشروع (إدخال يدوي، منفصل عن حسابات المستخلصات)
model ClientPayment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  amount    Decimal  @db.Decimal(18, 2)
  date      DateTime @default(now())
  notes     String?
  createdById String?
  createdAt DateTime @default(now())

  @@map("client_payments")
}

// سحوبات الشريك من رصيده (منفصلة عن التمويل/الإيداع)
model PartnerWithdrawal {
  id          String   @id @default(cuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id])
  amount      Decimal  @db.Decimal(18, 2)
  date        DateTime @default(now())
  notes       String?
  createdById String?
  createdAt   DateTime @default(now())

  @@map("partner_withdrawals")
}

model ClosingReport {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  totalRevenue Decimal  @db.Decimal(18, 2)
  totalExpense Decimal  @db.Decimal(18, 2)
  netProfit    Decimal  @db.Decimal(18, 2)
  closedAt     DateTime @default(now())
  notes        String?

  @@map("closing_reports")
}

// ============================================================
// Module 2 — Contracts & Payment Certificates (العقود والمستخلصات)
// ============================================================

model Contract {
  id                   String   @id @default(cuid())
  projectId            String   @unique
  project              Project  @relation(fields: [projectId], references: [id])
  contractNumber       String   @unique
  signedDate           DateTime
  durationDays         Int?
  retentionPct         Decimal  @default(5) @db.Decimal(5, 2)   // نسبة ضمان حسن التنفيذ
  advancePaymentPct    Decimal  @default(0) @db.Decimal(5, 2)   // نسبة الدفعة المقدمة
  advancePaymentAmount Decimal  @default(0) @db.Decimal(18, 2)
  notes                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  boqItems     BoqItem[]
  certificates PaymentCertificate[]

  @@map("contracts")
}

// بنود جدول الكميات (Bill of Quantities)
model BoqItem {
  id          String   @id @default(cuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id])
  code        String
  description String
  unit        String
  quantity    Decimal  @db.Decimal(18, 3)
  unitPrice   Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now())

  @@map("boq_items")
}

enum CertificateStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
}

// المستخلصات — بنسبة إنجاز تراكمية زي المتبع في المقاولات المصرية
model PaymentCertificate {
  id                     String            @id @default(cuid())
  contractId             String
  contract               Contract          @relation(fields: [contractId], references: [id])
  number                 Int
  periodFrom             DateTime
  periodTo               DateTime
  cumulativePct          Decimal           @db.Decimal(5, 2) // نسبة الإنجاز التراكمية %
  previousCumulativeValue Decimal          @default(0) @db.Decimal(18, 2)
  cumulativeValue        Decimal           @db.Decimal(18, 2) // = cumulativePct% × قيمة العقد
  thisPeriodValue        Decimal           @db.Decimal(18, 2) // = cumulativeValue - previousCumulativeValue
  retentionAmount        Decimal           @db.Decimal(18, 2)
  advanceRecoveryAmount  Decimal           @default(0) @db.Decimal(18, 2)
  taxAmount               Decimal          @default(0) @db.Decimal(18, 2)
  netPayable              Decimal          @db.Decimal(18, 2)
  status                  CertificateStatus @default(DRAFT)
  submittedDate            DateTime?
  approvedDate              DateTime?
  paidDate                  DateTime?
  notes                     String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  @@unique([contractId, number])
  @@map("payment_certificates")
}

// ============================================================
// Module 3 — Suppliers & Procurement (الموردين والمشتريات)
// ============================================================

enum SupplierCategory {
  MATERIALS
  EQUIPMENT
  SUBCONTRACTOR
  SERVICES
  OTHER
}

// ============================================================
// Module — Contractors (مقاولي الباطن)
// ============================================================

model Subcontractor {
  id         String   @id @default(cuid())
  name       String
  specialty  String?  // التخصص (كهرباء، سباكة، تشطيبات...)
  phone      String?
  email      String?
  taxNumber  String?
  address    String?
  isActive   Boolean  @default(true)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contracts   SubcontractorContract[]
  evaluations SubcontractorEvaluation[]

  @@map("subcontractors")
}

enum SubcontractorContractStatus {
  ACTIVE
  COMPLETED
  TERMINATED
}

// عقد مقاول باطن — مربوط بمشروع محدد إجباريًا (الفلتر المطلوب)
model SubcontractorContract {
  id              String                      @id @default(cuid())
  subcontractorId String
  subcontractor   Subcontractor               @relation(fields: [subcontractorId], references: [id])
  projectId       String
  project         Project                     @relation(fields: [projectId], references: [id])
  contractNumber  String
  scopeOfWork     String? // نطاق العمل
  contractValue   Decimal                     @db.Decimal(18, 2)
  signedDate      DateTime
  status          SubcontractorContractStatus @default(ACTIVE)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  certificates SubcontractorCertificate[]
  payments     SubcontractorPayment[]

  @@unique([projectId, contractNumber])
  @@map("subcontractor_contracts")
}

enum SubcontractorCertificateStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
}

// مستخلص مقاول الباطن — بنفس منهجية النسبة التراكمية المستخدمة في مستخلصات العميل
model SubcontractorCertificate {
  id               String                          @id @default(cuid())
  contractId       String
  contract         SubcontractorContract           @relation(fields: [contractId], references: [id])
  number           Int
  periodFrom       DateTime
  periodTo         DateTime
  cumulativePct    Decimal                         @db.Decimal(6, 3)
  thisPeriodValue  Decimal                         @db.Decimal(18, 2)
  status           SubcontractorCertificateStatus  @default(DRAFT)
  createdAt        DateTime                        @default(now())
  updatedAt        DateTime                        @updatedAt

  @@unique([contractId, number])
  @@map("subcontractor_certificates")
}

// دفعة فعلية لمقاول الباطن — بتتحمّل تلقائيًا كمصروف على المشروع
model SubcontractorPayment {
  id         String                @id @default(cuid())
  contractId String
  contract   SubcontractorContract @relation(fields: [contractId], references: [id])
  amount     Decimal               @db.Decimal(18, 2)
  date       DateTime              @default(now())
  notes      String?
  expenseId  String?               @unique // ربط بالمصروف المُنشأ تلقائيًا على المشروع
  createdById String?
  createdAt  DateTime              @default(now())

  @@map("subcontractor_payments")
}

// تقييم أداء مقاول الباطن لكل مشروع
model SubcontractorEvaluation {
  id              String        @id @default(cuid())
  subcontractorId String
  subcontractor   Subcontractor @relation(fields: [subcontractorId], references: [id])
  projectId       String?
  qualityScore    Int // 1-5
  timelinessScore Int // 1-5
  safetyScore     Int // 1-5
  notes           String?
  evaluatedAt     DateTime      @default(now())
  createdById     String?
  createdAt       DateTime      @default(now())

  @@map("subcontractor_evaluations")
}

// ============================================================
// Module — Site Management (إدارة الموقع)
// ============================================================

// تقرير يومي للموقع — يجمع كل أنشطة اليوم في مشروع معين
model SiteDailyReport {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])
  date         DateTime @default(now())
  weatherNotes String? // ملاحظات الطقس
  generalNotes String? // ملاحظات عامة عن اليوم
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workerAttendance SiteWorkerAttendance[]
  equipmentLogs    SiteEquipmentLog[]
  materialLogs     SiteMaterialLog[]
  photos           SitePhoto[]

  @@unique([projectId, date])
  @@map("site_daily_reports")
}

// حضور العمال في اليوم — بالحرفة والعدد (مش لازم يكونوا موظفين مسجلين في HR)
model SiteWorkerAttendance {
  id       String          @id @default(cuid())
  reportId String
  report   SiteDailyReport @relation(fields: [reportId], references: [id])
  trade    String // الحرفة: حداد، نجار، عامل عادي، سباك...
  count    Int // عدد العمال
  notes    String?
  createdAt DateTime @default(now())

  @@map("site_worker_attendance")
}

// المعدات الموجودة بالموقع في اليوم ده
model SiteEquipmentLog {
  id          String          @id @default(cuid())
  reportId    String
  report      SiteDailyReport @relation(fields: [reportId], references: [id])
  equipmentId String?
  equipment   Equipment?      @relation(fields: [equipmentId], references: [id])
  customName  String? // لو المعدة مش مسجلة في قائمة المعدات
  hoursUsed   Float?
  notes       String?
  createdAt   DateTime        @default(now())

  @@map("site_equipment_logs")
}

// استهلاك المواد في اليوم — لو مربوط بصنف مخزون فعلي، بيتسجل منصرف حقيقي من المخزن
model SiteMaterialLog {
  id          String          @id @default(cuid())
  reportId    String
  report      SiteDailyReport @relation(fields: [reportId], references: [id])
  itemId      String?
  item        InventoryItem?  @relation(fields: [itemId], references: [id])
  customName  String? // لو المادة مش مسجلة في المخزون
  quantity    Decimal         @db.Decimal(18, 3)
  unit        String?
  stockMovementId String?     @unique // ربط بحركة المخزون الفعلية لو اتخصمت
  notes       String?
  createdAt   DateTime        @default(now())

  @@map("site_material_logs")
}

// صور الموقع لليوم (مخزّنة كـ data URL لحد ما يتضاف تخزين سحابي)
model SitePhoto {
  id        String          @id @default(cuid())
  reportId  String
  report    SiteDailyReport @relation(fields: [reportId], references: [id])
  url       String          @db.Text
  caption   String?
  createdAt DateTime        @default(now())

  @@map("site_photos")
}

enum SiteRequestType {
  PURCHASE // طلب شراء من مورد
  LABOR    // طلب عدد عمالة
}

enum SiteRequestStatus {
  PENDING_FINANCE // في انتظار اعتماد المدير المالي
  PENDING_ADMIN   // اتاعتمد من المالي، في انتظار اعتماد الأدمن
  APPROVED        // اتاعتمد نهائيًا من الاتنين
  REJECTED
}

// طلب من مهندس الموقع (شراء مادة من مورد، أو طلب عدد عمالة) — بيمر باعتماد المدير المالي، وبعدين الأدمن
model SiteRequest {
  id           String          @id @default(cuid())
  serialNumber Int             @unique // رقم مسلسل تلقائي تصاعدي
  code         String          @unique // كود تلقائي، مثال: SR-000123
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id])
  type         SiteRequestType

  // بيانات طلب الشراء
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  itemDescription String?
  estimatedAmount Decimal?  @db.Decimal(18, 2)

  // بيانات طلب العمالة
  trade        String?
  workersCount Int?
  neededDate   DateTime?

  notes  String?
  status SiteRequestStatus @default(PENDING_FINANCE)

  requestedById       String?
  financeApprovedById String?
  financeApprovedAt   DateTime?
  adminApprovedById   String?
  adminApprovedAt     DateTime?
  rejectedById        String?
  rejectionReason     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_requests")
}

model Supplier {
  id         String           @id @default(cuid())
  name       String
  category   SupplierCategory @default(MATERIALS)
  phone      String?
  email      String?
  address    String?
  taxNumber  String?
  isActive   Boolean          @default(true)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  purchaseOrders PurchaseOrder[]
  siteRequests   SiteRequest[]

  @@map("suppliers")
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  RECEIVED
  PAID
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  poNumber    String              @unique
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  projectId   String?
  project     Project?            @relation(fields: [projectId], references: [id])
  status      PurchaseOrderStatus @default(DRAFT)
  orderDate   DateTime            @default(now())
  expectedDate DateTime?
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  items PurchaseOrderItem[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  description     String
  unit            String
  quantity        Decimal       @db.Decimal(18, 3)
  unitPrice       Decimal       @db.Decimal(18, 2)

  @@map("purchase_order_items")
}

// ============================================================
// Module 4 — Warehouses & Inventory (المخازن)
// ============================================================

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  movements StockMovement[]

  @@map("warehouses")
}

model InventoryItem {
  id           String   @id @default(cuid())
  name         String
  unit         String
  reorderLevel Decimal  @default(0) @db.Decimal(18, 3) // حد إعادة الطلب — تحته يُعتبر مخزون منخفض
  notes        String?
  createdAt    DateTime @default(now())

  movements StockMovement[]
  siteMaterialLogs SiteMaterialLog[]

  @@map("inventory_items")
}

enum MovementType {
  IN  // وارد (توريد من مورد، إرجاع من مشروع)
  OUT // منصرف (لمشروع، تالف)
}

model StockMovement {
  id          String        @id @default(cuid())
  warehouseId String
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id])
  type        MovementType
  quantity    Decimal       @db.Decimal(18, 3)
  projectId   String?
  project     Project?      @relation(fields: [projectId], references: [id])
  date        DateTime      @default(now())
  notes       String?
  createdById String?
  createdAt   DateTime      @default(now())

  @@map("stock_movements")
}

// ============================================================
// Module 5 — Equipment (المعدات)
// ============================================================

enum EquipmentStatus {
  AVAILABLE      // متاحة
  IN_USE         // بمشروع
  MAINTENANCE    // بالصيانة
  OUT_OF_SERVICE // خارج الخدمة
}

model Equipment {
  id           String          @id @default(cuid())
  name         String
  type         String
  serialNumber String?         @unique
  status       EquipmentStatus @default(AVAILABLE)
  purchaseDate DateTime?
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  assignments      EquipmentAssignment[]
  maintenanceLogs  MaintenanceLog[]
  siteEquipmentLogs SiteEquipmentLog[]

  @@map("equipment")
}

model EquipmentAssignment {
  id          String     @id @default(cuid())
  equipmentId String
  equipment   Equipment  @relation(fields: [equipmentId], references: [id])
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id])
  fromDate    DateTime   @default(now())
  toDate      DateTime?  // null = لسه بالمشروع
  notes       String?
  createdAt   DateTime   @default(now())

  @@map("equipment_assignments")
}

model MaintenanceLog {
  id          String    @id @default(cuid())
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  date        DateTime  @default(now())
  cost        Decimal   @default(0) @db.Decimal(18, 2)
  description String
  performedBy String?
  createdAt   DateTime  @default(now())

  @@map("maintenance_logs")
}

// ============================================================
// Module 6 — HR & Payroll (الموارد البشرية والرواتب)
// ============================================================

model Employee {
  id          String   @id @default(cuid())
  name        String
  jobTitle    String
  department  String?
  phone       String?
  email       String?
  nationalId  String?  @unique
  hireDate    DateTime
  baseSalary  Decimal  @db.Decimal(18, 2)
  bankName          String? // لملف تحويل البنك
  bankAccountNumber String?
  projectId   String?  // لو فاضي = مخصص للمكتب الرئيسي؛ ولو متحدد = محمّل على المشروع ده مباشرة
  project     Project? @relation(fields: [projectId], references: [id])
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payrollRecords    PayrollRecord[]
  attendanceRecords AttendanceRecord[]
  contracts         EmployeeContract[]
  advances          EmployeeAdvance[]
  penalties         EmployeePenalty[]
  leaveRequests     LeaveRequest[]

  @@map("employees")
}

// عقد عمل الموظف
model EmployeeContract {
  id           String    @id @default(cuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  contractType String    // دائم / مؤقت / تحت الاختبار...
  startDate    DateTime
  endDate      DateTime?
  salary       Decimal   @db.Decimal(18, 2)
  notes        String?
  createdAt    DateTime  @default(now())

  @@map("employee_contracts")
}

// سلفة على الموظف
model EmployeeAdvance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  amount     Decimal  @db.Decimal(18, 2)
  date       DateTime @default(now())
  reason     String?
  deducted   Boolean  @default(false) // اتخصمت من الراتب ولا لسه
  createdAt  DateTime @default(now())

  @@map("employee_advances")
}

// جزاء على الموظف
model EmployeePenalty {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])
  amount     Decimal  @db.Decimal(18, 2)
  date       DateTime @default(now())
  reason     String
  createdAt  DateTime @default(now())

  @@map("employee_penalties")
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

// طلب إجازة
model LeaveRequest {
  id         String      @id @default(cuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id])
  type       LeaveType   @default(ANNUAL)
  startDate  DateTime
  endDate    DateTime
  status     LeaveStatus @default(PENDING)
  notes      String?
  createdAt  DateTime    @default(now())

  @@map("leave_requests")
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

model PayrollRecord {
  id          String        @id @default(cuid())
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id])
  month       String        // صيغة "YYYY-MM"
  baseSalary  Decimal       @db.Decimal(18, 2)
  allowances  Decimal       @default(0) @db.Decimal(18, 2)
  overtimeAmount Decimal    @default(0) @db.Decimal(18, 2)
  deductions  Decimal       @default(0) @db.Decimal(18, 2) // تأمينات/ضريبة/جزاءات/سلف
  netSalary   Decimal       @db.Decimal(18, 2)
  status      PayrollStatus @default(DRAFT)
  paidDate    DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([employeeId, month])
  @@map("payroll_records")
}

// ============================================================
// Module 7 — Attendance (الحضور والانصراف)
// ============================================================

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  SICK
}

model AttendanceRecord {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id])
  date       DateTime
  status     AttendanceStatus @default(PRESENT)
  checkIn    DateTime?
  checkOut   DateTime?
  notes      String?
  createdAt  DateTime         @default(now())

  @@unique([employeeId, date])
  @@map("attendance_records")
}

// ---------------- Notifications & Audit ----------------

enum NotificationType {
  PROJECT_READY_TO_CLOSE
  PARTNER_CONTRIBUTION_EDITED
  PROJECT_REOPENED
  CONTRACT_VALUE_EDITED
  EXPENSE_EDITED
  PROJECT_CREATED
  PROJECT_CLOSED
  CONTRACT_CREATED
  CERTIFICATE_SUBMITTED
  CERTIFICATE_APPROVED
  CERTIFICATE_PAID
  PURCHASE_ORDER_CREATED
  PURCHASE_ORDER_APPROVED
  EQUIPMENT_ASSIGNED
  EQUIPMENT_MAINTENANCE
  PAYROLL_GENERATED
  PAYROLL_PAID
  MILESTONE_COMPLETED
  VARIATION_ORDER_APPROVED
  EMPLOYEE_ADVANCE_RECORDED
  EMPLOYEE_PENALTY_RECORDED
  LEAVE_REQUEST_SUBMITTED
  HEAD_OFFICE_EXPENSE_DISTRIBUTED
  SUBCONTRACTOR_PAYMENT_RECORDED
  SITE_REQUEST_SUBMITTED
  SITE_REQUEST_FINANCE_APPROVED
  SITE_REQUEST_APPROVED
  SITE_REQUEST_REJECTED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  message   String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // e.g. "PROJECT_UPDATED", "EXPENSE_DELETED"
  entityType String   // e.g. "Project"
  entityId   String?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}
